{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 6,
  "margin-top": 12,
  "margin-left": 18,
  "margin-right": 18,
  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "battery", "tray"],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {"active": "●", "default": "○"},
    "all-outputs": true,
    "sort-by-number": true
  },
  "niri/window": {"max-length": 48, "icon": true, "format": "{title}"},
  "clock": {"format": "{:%a  ·  %d %b  ·  %H:%M}", "tooltip-format": "{calendar}"},
  "network": {"format-wifi": "Wi-Fi  {signalStrength}%", "format-ethernet": "Ethernet", "format-disconnected": "Offline", "tooltip-format": "{ifname}: {essid}"},
  "pulseaudio": {"format": "Audio  {volume}%", "format-muted": "Audio muted", "scroll-step": 5},
  "battery": {"format": "Battery  {capacity}%", "format-charging": "Charging  {capacity}%"},
  "tray": {"spacing": 8}
}
