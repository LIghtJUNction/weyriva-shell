{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 6,
  "margin-top": 12,
  "margin-left": 18,
  "margin-right": 18,
  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "battery", "tray"],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {"active": "●", "default": "○"},
    "all-outputs": true,
    "sort-by-number": true
  },
  "niri/window": {"max-length": 48, "icon": true, "format": "{title}"},
  "clock": {"format": "{:%a  ·  %d %b  ·  %H:%M}", "tooltip-format": "{calendar}"},
  "network": {"format-wifi": "󰤨  {signalStrength}%", "format-ethernet": "󰈀  wired", "format-disconnected": "󰤭  offline", "tooltip-format": "{ifname}: {essid}"},
  "pulseaudio": {"format": "{icon}  {volume}%", "format-muted": "󰖁  muted", "format-icons": ["󰕿", "󰖀", "󰕾"], "scroll-step": 5},
  "battery": {"format": "{icon}  {capacity}%", "format-charging": "󰂄  {capacity}%", "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]},
  "tray": {"spacing": 8}
}
