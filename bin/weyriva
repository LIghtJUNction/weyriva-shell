VERSION: Final = "0.1.0"
PROTOCOL_VERSION: Final = 1
MAX_REQUEST_BYTES: Final = 64 * 1024
MAX_PLUGIN_OUTPUT_BYTES: Final = 1024 * 1024
DEFAULT_TIMEOUT: Final = 3.0
RESERVED_PREFIX: Final = "weyriva."
MAX_HANDLERS: Final = 16
READ_TIMEOUT: Final = 3.0
PLUGIN_ID_PATTERN: Final = re.compile(r"^[a-z][a-z0-9-]{1,63}$")
RUNTIME_COMMANDS: Final = ("niri", "niri-session", "noctalia", "noctalia-greeter-session", "foot")
PACKAGED_CONFIG_ROOT: Final = Path("/usr/share/weyriva/config")
PACKAGED_DATA_ROOT: Final = Path("/usr/share/weyriva")
PACKAGED_UNIT_ROOT: Final = Path("/usr/lib/systemd/user")
GREETD_TEMPLATE: Final = Path("/usr/share/weyriva/greetd/config.toml")
GREETD_CONFIG: Final = Path("/etc/greetd/config.toml")
GREETD_PAM: Final = Path("/etc/pam.d/greetd")
GREETER_SESSION: Final = Path("/usr/bin/noctalia-greeter-session")
GREETER_STATE_DIR: Final = Path("/var/lib/noctalia-greeter")
GREETER_USER: Final = "greeter"
SESSION_ENTRY: Final = Path("/usr/share/wayland-sessions/weyriva.desktop")
WEYRIVA_UNITS: Final = (
    "weyriva-ipc.service",
    "weyriva-shell.service",
    "weyriva-session-failsafe.service",
)
NIRI_WANTED_UNITS: Final = ("weyriva-ipc.service", "weyriva-shell.service")
REQUIRED_WALLPAPERS: Final = (
    "light/weyriva-cactus.png",
    "dark/weyriva-cactus-dark.png",
)
LOCK_RECONCILE_ATTEMPTS: Final = 20
LOCK_RECONCILE_INTERVAL: Final = 0.25
SESSION_ID_PATTERN: Final = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
LEGACY_UNIT_MARKERS: Final = {
    "weyriva-waybar.service": ("ExecStart=/usr/bin/waybar",),
    "weyriva-mako.service": ("ExecStart=/usr/bin/mako",),
    "weyriva-wallpaper.service": ("ExecStart=%h/.local/bin/weyriva wallpaper",),
    "weyriva-idle.service": ("ExecStart=%h/.local/bin/weyriva idle",),
    "weyriva-ipc.service": (
