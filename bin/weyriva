)
JsonValue = None | bool | int | float | str | list["JsonValue"] | dict[str, "JsonValue"]


class ProtocolError(ValueError):
    """A client request violates the IPC protocol."""

    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


class PluginError(RuntimeError):
    """A plugin manifest or invocation is invalid."""


@dataclass(frozen=True)
class PluginMethod:
    plugin: str
    method: str
    argv: tuple[str, ...]
    timeout: float
    manifest: Path


@dataclass(frozen=True)
class PluginRegistry:
    methods: dict[str, PluginMethod]
    manifests: tuple[Path, ...]
    errors: tuple[str, ...]


@dataclass(frozen=True)
class DiagnosticCheck:
    name: str
    status: str
    detail: str


@dataclass(frozen=True)
class StartupPlan:
    target_user: str
    user_home: Path
    user_uid: int
    user_gid: int
    niri_config: Path
    greeter_uid: int
    greeter_gid: int
    backup_root: Path
    greetd_backup: Path
    greetd_changed: bool
    unit_root: Path
    units_to_back_up: tuple[str, ...]


def _diagnostic_command(name: str) -> str | None:
    return shutil.which(name)


def _diagnostic_check(name: str, status: str, detail: str) -> DiagnosticCheck:
    return DiagnosticCheck(name=name, status=status, detail=detail)


def _run_diagnostic_command(command: list[str], timeout: float = 5.0) -> tuple[int, str]:
    try:
        completed = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except (FileNotFoundError, subprocess.TimeoutExpired) as error:
        return 127, str(error)
    output = (completed.stdout.strip() or completed.stderr.strip()).replace("\n", " ")
    return completed.returncode, output


def _config_home(environment: Mapping[str, str]) -> Path:
    return Path(environment.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def _state_home(environment: Mapping[str, str]) -> Path:
    return Path(environment.get("XDG_STATE_HOME", Path.home() / ".local/state"))


def _data_home(environment: Mapping[str, str]) -> Path:
    return Path(environment.get("XDG_DATA_HOME", Path.home() / ".local/share"))


def noctalia_profile_environment(environment: Mapping[str, str]) -> dict[str, str]:
    """Return a child environment isolated from any standalone Noctalia profile."""
    child_environment = dict(environment)
    child_environment["NOCTALIA_CONFIG_HOME"] = str(_config_home(environment) / "weyriva")
    child_environment["NOCTALIA_STATE_HOME"] = str(_state_home(environment) / "weyriva")
    child_environment["NOCTALIA_DATA_HOME"] = str(_data_home(environment) / "weyriva")
    return child_environment


def noctalia_argv(arguments: list[str]) -> list[str]:
    return ["noctalia", *arguments]


def _safe_destination_directory(path: Path) -> Path:
    expanded = path.expanduser()
    if not expanded.is_absolute():
        raise RuntimeError(f"seed destination must be absolute: {expanded}")
    destination = Path(os.path.abspath(expanded))
    current = Path(destination.anchor)
    for component in destination.parts[1:]:
        current /= component
        if current.is_symlink():
            raise RuntimeError(f"refusing to seed through symlink: {current}")
        if current.exists() and not current.is_dir():
            raise RuntimeError(f"seed destination component is not a directory: {current}")
    destination.mkdir(mode=0o755, parents=True, exist_ok=True)
    if destination.is_symlink() or not destination.is_dir():
        raise RuntimeError(f"unsafe seed destination directory: {destination}")
    return destination


def _seed_missing_regular_files(source_root: Path, destination_root: Path) -> tuple[Path, ...]:
    destination = _safe_destination_directory(destination_root)
    if source_root.is_symlink() or not source_root.is_dir():
        raise RuntimeError(f"packaged seed directory is unavailable: {source_root}")

    seeded: list[Path] = []
    for source in sorted(source_root.rglob("*")):
        if source.is_symlink():
            raise RuntimeError(f"packaged seed contains a symlink: {source}")
        if not source.is_file():
            continue
        relative = source.relative_to(source_root)
        target = destination / relative
        _safe_destination_directory(target.parent)
        if target.is_symlink():
            raise RuntimeError(f"refusing to seed a symlinked file: {target}")
        if target.exists():
            if not target.is_file():
                raise RuntimeError(f"seed destination is not a regular file: {target}")
            continue

        source_mode = stat.S_IMODE(source.stat().st_mode)
        descriptor: int | None = None
        try:
            open_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            open_flags |= getattr(os, "O_NOFOLLOW", 0)
            descriptor = os.open(target, open_flags, source_mode)
            with source.open("rb") as source_stream, os.fdopen(descriptor, "wb") as target_stream:
                descriptor = None
                shutil.copyfileobj(source_stream, target_stream)
            seeded.append(target)
        except FileExistsError as error:
            if target.is_symlink():
                raise RuntimeError(f"refusing to seed a symlinked file: {target}") from error
            if not target.is_file():
                raise RuntimeError(f"seed destination is not a regular file: {target}") from error
        except Exception:
            if descriptor is not None:
                os.close(descriptor)
            if target.is_file() and not target.is_symlink():
                target.unlink()
            raise
    return tuple(seeded)


def seed_noctalia_profile(environment: Mapping[str, str]) -> tuple[Path, ...]:
    profile_environment = noctalia_profile_environment(environment)
    config_destination = Path(profile_environment["NOCTALIA_CONFIG_HOME"]) / "noctalia"
    home = Path(environment.get("HOME", Path.home())).expanduser()
    wallpaper_destination = home / ".local/share/weyriva/wallpapers"
    pairs = (
        (PACKAGED_CONFIG_ROOT / "noctalia", config_destination),
        (PACKAGED_DATA_ROOT / "wallpapers", wallpaper_destination),
    )

    seeded: list[Path] = []
    for source, destination in pairs:
        if source.is_dir() and not source.is_symlink():
            seeded.extend(_seed_missing_regular_files(source, destination))
            continue
        safe_destination = _safe_destination_directory(destination)
        if not any(path.is_file() and not path.is_symlink() for path in safe_destination.rglob("*")):
            raise RuntimeError(f"packaged seed directory is unavailable: {source}")
    return tuple(seeded)


def run_noctalia(arguments: list[str], environment: Mapping[str, str]) -> NoReturn:
    command = noctalia_argv(arguments)
    os.execvpe(command[0], command, noctalia_profile_environment(environment))
    raise RuntimeError("noctalia exec unexpectedly returned")


def _noctalia_ipc(arguments: list[str], environment: Mapping[str, str]) -> dict[str, JsonValue]:
    command = noctalia_argv(["msg", *arguments])
    try:
        completed = subprocess.run(
            command,
            env=noctalia_profile_environment(environment),
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as error:
        raise ProtocolError("unavailable", f"Noctalia IPC unavailable: {error}") from error
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "Noctalia IPC failed"
        raise ProtocolError("action_failed", detail)
    return {"command": arguments[0], "output": completed.stdout.strip()}


def niri_config_path(environment: Mapping[str, str]) -> Path:
    selected = environment.get("NIRI_CONFIG")
    if selected:
        return Path(selected).expanduser()
    config_home = _config_home(environment)
    user_config = config_home / "niri/config.kdl"
    if user_config.is_file():
        return user_config
    return PACKAGED_CONFIG_ROOT / "niri/config.kdl"


def reconcile_startup_file(source: Path, destination: Path, backup: Path) -> bool:
    if not source.is_file():
        raise RuntimeError(f"required startup template is missing: {source}")
    if destination.is_symlink():
        raise RuntimeError(f"refusing to replace symlink: {destination}")
    source_data = source.read_bytes()
    if destination.is_file() and destination.read_bytes() == source_data:
        return False
    destination.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    if destination.exists():
        backup.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        shutil.copy2(destination, backup)
    temporary = destination.with_name(f".{destination.name}.weyriva-{os.getpid()}.tmp")
    try:
        temporary.write_bytes(source_data)
        temporary.chmod(0o644)
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)
    return True


def legacy_user_units(unit_root: Path) -> tuple[str, ...]:
    found: list[str] = []
    for name, markers in LEGACY_UNIT_MARKERS.items():
        unit = unit_root / name
        if not unit.is_file() or unit.is_symlink():
            continue
        try:
            content = unit.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        if any(marker in content for marker in markers):
            found.append(name)
    return tuple(found)


def legacy_override_units(unit_root: Path) -> tuple[str, ...]:
    return tuple(name for name in legacy_user_units(unit_root) if (PACKAGED_UNIT_ROOT / name).is_file())


def back_up_legacy_user_units(
    unit_root: Path,
    backup_root: Path,
    names: tuple[str, ...] | None = None,
) -> tuple[str, ...]:
    moved: list[str] = []
    for name in legacy_user_units(unit_root) if names is None else names:
        unit = unit_root / name
        backup_root.mkdir(mode=0o700, parents=True, exist_ok=True)
        shutil.move(str(unit), str(backup_root / name))
        moved.append(name)
    return tuple(moved)


def _chown_tree(root: Path, uid: int, gid: int) -> None:
    if not root.exists():
        return
    for path in (root, *root.rglob("*")):
        os.chown(path, uid, gid, follow_symlinks=False)


def _run_checked(command: list[str], description: str) -> None:
    completed = subprocess.run(command, capture_output=True, text=True, timeout=15, check=False)
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or f"exit {completed.returncode}"
        raise RuntimeError(f"{description} failed: {detail}")


def validate_greetd_pam(path: Path) -> None:
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"greetd PAM stack is unavailable or unsafe: {path}")
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError) as error:
        raise RuntimeError(f"cannot read greetd PAM stack: {path}") from error
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        if len(fields) >= 3 and fields[0].lstrip("-") == "session":
            return
    raise RuntimeError(
        f"greetd PAM stack has no active session rule or include: {path}"
    )


def greeter_identity() -> tuple[int, int]:
    try:
        account = pwd.getpwnam(GREETER_USER)
        group = grp.getgrnam(GREETER_USER)
    except KeyError as error:
        raise RuntimeError("the greeter account and group are required") from error
    if account.pw_gid != group.gr_gid:
        raise RuntimeError("the greeter account must use the greeter group")
    return account.pw_uid, group.gr_gid


def validate_safe_directory_chain(path: Path, *, require_leaf: bool = False) -> None:
    if not path.is_absolute():
        raise RuntimeError(f"path must be absolute: {path}")
    current = Path(path.anchor)
    for component in path.parts[1:]:
        current /= component
        if current.is_symlink():
            raise RuntimeError(f"refusing path containing a symlink: {current}")
        if current.exists() and not current.is_dir():
            raise RuntimeError(f"path component is not a directory: {current}")
    if require_leaf and not path.is_dir():
        raise RuntimeError(f"required directory is unavailable: {path}")


def validate_greeter_state_path(path: Path) -> None:
    if path.is_symlink():
        raise RuntimeError(f"refusing symlinked greeter state directory: {path}")
    if path.exists() and not path.is_dir():
        raise RuntimeError(f"greeter state path is not a directory: {path}")
    parent = path.parent
    validate_safe_directory_chain(parent, require_leaf=True)


def ensure_greeter_state_directory(path: Path, uid: int, gid: int) -> None:
    validate_greeter_state_path(path)
    if not path.exists():
        path.mkdir(mode=0o750)

    flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise RuntimeError(f"cannot safely open greeter state directory: {path}") from error
    try:
        os.fchmod(descriptor, 0o750)
        os.fchown(descriptor, uid, gid)
    finally:
        os.close(descriptor)


def reconcile_lock(
    environment: Mapping[str, str],
    *,
    attempts: int = LOCK_RECONCILE_ATTEMPTS,
    interval: float = LOCK_RECONCILE_INTERVAL,
    runner: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
    sleeper: Callable[[float], None] = time.sleep,
) -> int:
    """Reacquire Noctalia's session lock after a shell restart when logind is locked."""
    if attempts < 1:
        raise ValueError("lock reconciliation requires at least one attempt")
    command_options = {
        "capture_output": True,
        "text": True,
        "timeout": 5,
        "check": False,
    }
    raw_session_id = environment.get("XDG_SESSION_ID", "")
    session_id = raw_session_id
    if not raw_session_id.strip():
        try:
            display = runner(
                ["loginctl", "show-user", str(os.getuid()), "-p", "Display", "--value"],
                **command_options,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired):
            return 1
        if display.returncode != 0:
            return 1
        session_id = display.stdout.strip()
    if session_id != session_id.strip() or SESSION_ID_PATTERN.fullmatch(session_id) is None:
        return 1
    try:
        state = runner(
            ["loginctl", "show-session", session_id, "-p", "LockedHint", "--value"],
            **command_options,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return 1
    if state.returncode != 0:
        return 1
    locked_hint = state.stdout.strip().lower()
    if locked_hint == "no":
        return 0
    if locked_hint != "yes":
        return 1

    child_environment = noctalia_profile_environment(environment)
    for attempt in range(attempts):
        try:
            ready = runner(
                ["noctalia", "msg", "status"],
                env=child_environment,
                **command_options,
            )
        except (FileNotFoundError, subprocess.TimeoutExpired):
            ready = None
        if ready is not None and ready.returncode == 0:
            try:
                locked = runner(
                    ["noctalia", "msg", "session", "lock"],
                    env=child_environment,
                    **command_options,
                )
            except (FileNotFoundError, subprocess.TimeoutExpired):
                return 1
            return 0 if locked.returncode == 0 else 1
        if attempt + 1 < attempts:
            sleeper(interval)
    return 1


def preflight_startup_chain(target_user: str) -> StartupPlan:
    if os.geteuid() != 0:
        raise RuntimeError("startup ensure requires root; run: sudo weyriva startup ensure")
    if not target_user or target_user == "root":
        raise RuntimeError("cannot infer the desktop user; use --user USER")
    try:
        account = pwd.getpwnam(target_user)
    except KeyError as error:
        raise RuntimeError(f"unknown user: {target_user}") from error

    required = (
        SESSION_ENTRY,
        GREETD_TEMPLATE,
        GREETER_SESSION,
        PACKAGED_CONFIG_ROOT / "niri/config.kdl",
        *(PACKAGED_DATA_ROOT / "wallpapers" / name for name in REQUIRED_WALLPAPERS),
        *(PACKAGED_UNIT_ROOT / name for name in WEYRIVA_UNITS),
        *(PACKAGED_UNIT_ROOT / "niri.service.wants" / name for name in NIRI_WANTED_UNITS),
    )
    missing = [str(path) for path in required if not path.is_file()]
    if missing:
        raise RuntimeError("system installation is incomplete; missing: " + ", ".join(missing))
    for name in NIRI_WANTED_UNITS:
        link = PACKAGED_UNIT_ROOT / "niri.service.wants" / name
        if not link.is_symlink() or os.readlink(link) != f"../{name}":
            raise RuntimeError(f"invalid niri service dependency: {link}")
    missing_commands = [command for command in RUNTIME_COMMANDS if _diagnostic_command(command) is None]
    if missing_commands:
        raise RuntimeError("required commands are unavailable: " + ", ".join(missing_commands))
    service_code, service_output = _run_diagnostic_command(
        ["systemctl", "cat", "greetd.service"]
    )
    if service_code != 0:
        raise RuntimeError(
            "greetd service is unavailable: " + (service_output or "validation failed")
        )
    session_content = SESSION_ENTRY.read_text(encoding="utf-8", errors="replace")
    if "Exec=/usr/bin/weyriva session start" not in session_content:
        raise RuntimeError(f"invalid Weyriva session entry: {SESSION_ENTRY}")
    if "Name=Weyriva" not in session_content:
        raise RuntimeError(f"invalid Weyriva session name: {SESSION_ENTRY}")
    greetd_content = GREETD_TEMPLATE.read_text(encoding="utf-8", errors="replace")
    expected_greeter = (
        'command = "/usr/bin/noctalia-greeter-session -- --session Weyriva"'
    )
    if expected_greeter not in greetd_content or 'user = "greeter"' not in greetd_content:
        raise RuntimeError(f"invalid Weyriva greeter template: {GREETD_TEMPLATE}")
    if "tuigreet" in greetd_content:
        raise RuntimeError(f"obsolete tuigreet command remains in: {GREETD_TEMPLATE}")
    validate_greetd_pam(GREETD_PAM)
    greeter_uid, greeter_gid = greeter_identity()
    validate_greeter_state_path(GREETER_STATE_DIR)

    user_home = Path(account.pw_dir)
    validate_safe_directory_chain(user_home, require_leaf=True)
    user_environment = {
        "HOME": str(user_home),
        "XDG_CONFIG_HOME": str(user_home / ".config"),
    }
    config = niri_config_path(user_environment)
    code, output = _run_diagnostic_command(["niri", "validate", "-c", str(config)])
    if code != 0:
        raise RuntimeError(f"Niri config is invalid ({config}): {output or 'validation failed'}")

    timestamp = os.environ.get("WEYRIVA_STARTUP_TIMESTAMP") or time.strftime("%Y%m%d-%H%M%S")
    if re.fullmatch(r"\d{8}-\d{6}", timestamp) is None:
        raise RuntimeError("invalid Weyriva startup backup timestamp")
    backup_root = user_home / ".local/state/weyriva/startup-backups" / timestamp
    greetd_backup = backup_root / "greetd/config.toml"
    unit_root = user_home / ".config/systemd/user"
    validate_safe_directory_chain(unit_root)
    validate_safe_directory_chain(backup_root)
    validate_safe_directory_chain(GREETD_CONFIG.parent, require_leaf=True)
    if GREETD_CONFIG.is_symlink() or (GREETD_CONFIG.exists() and not GREETD_CONFIG.is_file()):
        raise RuntimeError(f"unsafe greetd configuration destination: {GREETD_CONFIG}")
    greetd_changed = (
        not GREETD_CONFIG.is_file()
        or GREETD_CONFIG.read_bytes() != GREETD_TEMPLATE.read_bytes()
    )
    units_to_back_up = legacy_user_units(unit_root)
    backup_targets = [
        *(backup_root / "systemd/user" / name for name in units_to_back_up),
    ]
    if greetd_changed and GREETD_CONFIG.exists():
        backup_targets.append(greetd_backup)
    conflicts = [str(path) for path in backup_targets if path.exists() or path.is_symlink()]
    if conflicts:
        raise RuntimeError("startup backup destination already exists: " + ", ".join(conflicts))
    return StartupPlan(
        target_user=target_user,
        user_home=user_home,
        user_uid=account.pw_uid,
        user_gid=account.pw_gid,
        niri_config=config,
        greeter_uid=greeter_uid,
        greeter_gid=greeter_gid,
        backup_root=backup_root,
        greetd_backup=greetd_backup,
        greetd_changed=greetd_changed,
        unit_root=unit_root,
        units_to_back_up=units_to_back_up,
    )


def ensure_startup_chain(target_user: str) -> int:
    plan = preflight_startup_chain(target_user)
    ensure_greeter_state_directory(
        GREETER_STATE_DIR,
        plan.greeter_uid,
        plan.greeter_gid,
    )
    greetd_changed = reconcile_startup_file(
        GREETD_TEMPLATE,
        GREETD_CONFIG,
        plan.greetd_backup,
    )
    moved_units = back_up_legacy_user_units(
        plan.unit_root,
        plan.backup_root / "systemd/user",
        plan.units_to_back_up,
    )
    _chown_tree(plan.backup_root, plan.user_uid, plan.user_gid)

    _run_checked(["systemctl", "enable", "greetd.service"], "enabling greetd")

    print(f"Weyriva Niri startup chain ensured for {plan.target_user}.")
    print(f"Niri config: {plan.niri_config}")
    print(f"greetd config: {'updated' if greetd_changed else 'already current'}")
    if moved_units:
        print("legacy user units backed up: " + ", ".join(moved_units))
        print(f"backup directory: {plan.backup_root}")
    else:
        print("legacy user units: none")
    print("greetd was not restarted; log out or reboot when ready.")
    return 0


def diagnose_checks() -> tuple[DiagnosticCheck, ...]:
    checks: list[DiagnosticCheck] = []
    for command in RUNTIME_COMMANDS:
        location = _diagnostic_command(command)
        if location is None:
            status = (
                "fail"
                if command in {"niri", "niri-session", "noctalia", "noctalia-greeter-session"}
                else "warn"
            )
            checks.append(_diagnostic_check(f"command:{command}", status, "not installed"))
        else:
            checks.append(_diagnostic_check(f"command:{command}", "ok", location))

    config = niri_config_path(os.environ)
    if not config.is_file():
        checks.append(_diagnostic_check("niri-config", "fail", f"missing: {config}"))
    elif _diagnostic_command("niri") is None:
        checks.append(_diagnostic_check("niri-config", "warn", f"not validated; niri is missing ({config})"))
    else:
        code, output = _run_diagnostic_command(["niri", "validate", "-c", str(config)])
        checks.append(_diagnostic_check("niri-config", "ok" if code == 0 else "fail", output or str(config)))

    desktop = SESSION_ENTRY
    if not desktop.is_file():
        checks.append(_diagnostic_check("session-entry", "fail", f"missing: {desktop}"))
    else:
        content = desktop.read_text(encoding="utf-8", errors="replace")
        expected = "Exec=/usr/bin/weyriva session start"
        checks.append(
            _diagnostic_check("session-entry", "ok" if expected in content else "fail", str(desktop))
        )

    greetd = GREETD_CONFIG
    if not greetd.is_file():
        checks.append(_diagnostic_check("greetd", "warn", f"missing: {greetd}"))
    else:
        content = greetd.read_text(encoding="utf-8", errors="replace")
        if "start-hyprland" in content or "agreety" in content:
            checks.append(_diagnostic_check("greetd", "fail", "still points to Hyprland/agreety"))
        elif (
            "/usr/bin/noctalia-greeter-session -- --session Weyriva" in content
            and 'user = "greeter"' in content
        ):
            checks.append(_diagnostic_check("greetd", "ok", "Weyriva Noctalia Greeter is configured"))
        elif "tuigreet" in content:
            checks.append(_diagnostic_check("greetd", "fail", "obsolete tuigreet login surface is configured"))
        else:
            checks.append(_diagnostic_check("greetd", "warn", "configured, but Weyriva login selection is unclear"))

    unit_root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "systemd/user"
    missing_units = [
        name for name in WEYRIVA_UNITS
        if not (unit_root / name).is_file() and not (PACKAGED_UNIT_ROOT / name).is_file()
    ]
    legacy_units = legacy_override_units(unit_root)
    if missing_units:
        checks.append(_diagnostic_check("user-services", "warn", "missing: " + ", ".join(missing_units)))
    elif legacy_units:
        checks.append(
            _diagnostic_check(
                "user-services",
                "fail",
                "legacy overrides: " + ", ".join(legacy_units) + "; run sudo weyriva startup ensure",
            )
        )
    else:
        overrides = [name for name in WEYRIVA_UNITS if (unit_root / name).is_file()]
        detail = "packaged defaults"
        if overrides:
            detail += "; user overrides: " + ", ".join(overrides)
        checks.append(_diagnostic_check("user-services", "ok", detail))

    if os.environ.get("XDG_RUNTIME_DIR"):
        code, output = _run_diagnostic_command(["systemctl", "--user", "is-system-running"], timeout=3)
        if code == 0:
            checks.append(_diagnostic_check("user-manager", "ok", output or "running"))
        else:
            checks.append(_diagnostic_check("user-manager", "warn", output or "unavailable"))
    else:
        checks.append(_diagnostic_check("user-manager", "warn", "XDG_RUNTIME_DIR is not set"))

    if os.environ.get("NIRI_SOCKET"):
        code, output = _run_diagnostic_command(["niri", "msg", "-j", "version"], timeout=3)
        checks.append(_diagnostic_check("niri-session", "ok" if code == 0 else "warn", output or "running"))
    else:
        checks.append(_diagnostic_check("niri-session", "warn", "not running in this environment"))
    return tuple(checks)


def diagnostic_summary(checks: tuple[DiagnosticCheck, ...]) -> dict[str, JsonValue]:
    return {
        "desktop": "niri",
        "ok": not any(check.status == "fail" for check in checks),
        "checks": [
            {"name": check.name, "status": check.status, "detail": check.detail} for check in checks
        ],
    }


def print_diagnostics(checks: tuple[DiagnosticCheck, ...]) -> None:
    symbols = {"ok": "OK", "warn": "WARN", "fail": "FAIL"}
    for check in checks:
        print(f"[{symbols[check.status]:4}] {check.name}: {check.detail}")
    failures = sum(check.status == "fail" for check in checks)
    warnings = sum(check.status == "warn" for check in checks)
    print(f"\nNiri diagnosis: {failures} failure(s), {warnings} warning(s)")


def xdg_runtime_dir() -> Path:
    configured = os.environ.get("XDG_RUNTIME_DIR")
    if not configured:
        raise RuntimeError("XDG_RUNTIME_DIR is not set; log in through a user session")
    path = Path(configured)
    if not path.is_dir():
        raise RuntimeError(f"XDG_RUNTIME_DIR does not exist: {path}")
    return path


def socket_path() -> Path:
    return xdg_runtime_dir() / "weyriva" / "weyriva.sock"


def plugin_roots() -> tuple[Path, ...]:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    data_home = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    data_dirs = tuple(
        Path(item) for item in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if item
    )
    return (config_home / "weyriva/plugins", data_home / "weyriva/plugins") + tuple(
        item / "weyriva/plugins" for item in data_dirs
    )


def _manifest_files() -> tuple[Path, ...]:
    found: list[Path] = []
    for root in plugin_roots():
        if root.is_dir():
            found.extend(sorted(root.glob("*.json")))
    return tuple(found)


def _parse_plugin(path: Path) -> tuple[str, dict[str, PluginMethod]]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise PluginError(f"cannot read JSON: {error}") from error
    if not isinstance(document, dict):
        raise PluginError("manifest root must be an object")
    plugin_id = document.get("id")
    version = document.get("version")
    methods = document.get("methods")
    if not isinstance(version, int) or isinstance(version, bool) or version != 1:
        raise PluginError("version must be integer 1")
    if not isinstance(plugin_id, str) or PLUGIN_ID_PATTERN.fullmatch(plugin_id) is None:
        raise PluginError("id must match [a-z][a-z0-9-]{1,63}")
    if not isinstance(methods, dict) or not methods:
        raise PluginError("methods must be a non-empty object")

    parsed: dict[str, PluginMethod] = {}
    for name, specification in methods.items():
        if (
            not isinstance(name, str)
            or not name.startswith(f"{plugin_id}.")
            or name.startswith(RESERVED_PREFIX)
        ):
            raise PluginError(f"invalid or reserved method name: {name!r}")
        if not isinstance(specification, dict):
            raise PluginError(f"method {name!r} must be an object")
        argv = specification.get("argv")
        timeout = specification.get("timeout", DEFAULT_TIMEOUT)
        if not isinstance(argv, list) or not argv or not all(isinstance(item, str) and item for item in argv):
            raise PluginError(f"method {name!r} argv must be a non-empty string array")
        if isinstance(timeout, bool) or not isinstance(timeout, (int, float)) or not 0.1 <= timeout <= 30:
            raise PluginError(f"method {name!r} timeout must be between 0.1 and 30 seconds")
        executable = Path(argv[0])
        resolved_argv = list(argv)
        if not executable.is_absolute() and "/" in argv[0]:
            resolved_argv[0] = str((path.parent / executable).resolve())
        parsed[name] = PluginMethod(plugin_id, name, tuple(resolved_argv), float(timeout), path)
    return plugin_id, parsed


def discover_plugins() -> PluginRegistry:
    registry: dict[str, PluginMethod] = {}
    accepted: list[Path] = []
    errors: list[str] = []
    for manifest in _manifest_files():
        try:
            _plugin_id, methods = _parse_plugin(manifest)
            duplicates = sorted(set(methods) & set(registry))
            if duplicates:
                raise PluginError(f"duplicate methods: {', '.join(duplicates)}")
            registry.update(methods)
            accepted.append(manifest)
        except PluginError as error:
            errors.append(f"{manifest}: {error}")
    return PluginRegistry(registry, tuple(accepted), tuple(errors))


def _terminate_group(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    if process.poll() is None:
        try:
            process.wait(timeout=0.2)
        except subprocess.TimeoutExpired:
            pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    if process.poll() is None:
        process.wait(timeout=1)


def run_plugin(method: PluginMethod, params: JsonValue) -> JsonValue:
    payload = json.dumps(params, ensure_ascii=False).encode()
    try:
        process = subprocess.Popen(
            method.argv,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except FileNotFoundError as error:
        raise PluginError(f"plugin executable not found: {method.argv[0]}") from error
    except PermissionError as error:
        raise PluginError(f"plugin executable is not runnable: {method.argv[0]}") from error
    assert process.stdin is not None and process.stdout is not None and process.stderr is not None
    try:
        process.stdin.write(payload)
        process.stdin.close()
    except BrokenPipeError:
        process.stdin.close()

    output = bytearray()
    error_output = bytearray()
    deadline = time.monotonic() + method.timeout
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, output)
    selector.register(process.stderr, selectors.EVENT_READ, error_output)
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                _terminate_group(process)
                raise PluginError(f"plugin timed out after {method.timeout:g}s")
            events = selector.select(remaining)
            if not events:
                _terminate_group(process)
                raise PluginError(f"plugin timed out after {method.timeout:g}s")
            for key, _mask in events:
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                destination: bytearray = key.data
                destination.extend(chunk)
                limit = MAX_PLUGIN_OUTPUT_BYTES if destination is output else 64 * 1024
                if len(destination) > limit:
                    _terminate_group(process)
                    stream = "stdout" if destination is output else "stderr"
                    raise PluginError(f"plugin {stream} exceeds {limit // 1024} KiB")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            _terminate_group(process)
            raise PluginError(f"plugin timed out after {method.timeout:g}s")
        return_code = process.wait(timeout=remaining)
    except subprocess.TimeoutExpired as error:
        _terminate_group(process)
        raise PluginError(f"plugin timed out after {method.timeout:g}s") from error
    finally:
        selector.close()
        process.stdout.close()
        process.stderr.close()
        if process.poll() is None:
            _terminate_group(process)

    if return_code != 0:
        stderr = error_output[:4096].decode(errors="replace").strip()
        raise PluginError(f"plugin exited {return_code}: {stderr or 'no error output'}")
    try:
        return json.loads(output)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise PluginError("plugin stdout is not one JSON value") from error


def validate_manifest(path: Path) -> dict[str, JsonValue]:
    if not path.is_file():
        raise PluginError(f"manifest file does not exist: {path}")
    plugin_id, methods = _parse_plugin(path)
    missing = sorted(
        {
            method.argv[0]
            for method in methods.values()
            if "/" in method.argv[0] and not Path(method.argv[0]).is_file()
        }
    )
    return {
        "id": plugin_id,
        "manifest": str(path),
        "methods": sorted(methods),
        "missing_executables": missing,
    }


def plugin_summary(registry: PluginRegistry) -> dict[str, JsonValue]:
    return {
        "plugins": [str(path) for path in registry.manifests],
        "methods": sorted(registry.methods),
        "errors": list(registry.errors),
    }


def _niri_json(arguments: list[str]) -> JsonValue:
    try:
        completed = subprocess.run(
            ["niri", "msg", "-j", *arguments], capture_output=True, text=True, timeout=3, check=False
        )
    except (FileNotFoundError, subprocess.TimeoutExpired) as error:
        raise ProtocolError("unavailable", f"niri msg unavailable: {error}") from error
    if completed.returncode != 0:
        raise ProtocolError("action_failed", completed.stderr.strip() or "niri msg failed")
    try:
        return json.loads(completed.stdout)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ProtocolError("action_failed", "niri msg returned invalid JSON") from error


def dispatch(
    method: str,
    params: JsonValue,
    registry: PluginRegistry,
    reloader: Callable[[], PluginRegistry] | None = None,
) -> JsonValue:
    match method:
        case "weyriva.ping":
            return {"pong": True, "protocol": PROTOCOL_VERSION}
        case "weyriva.info":
            return {"name": "Weyriva Shell", "version": VERSION, "protocol": PROTOCOL_VERSION}
        case "weyriva.methods":
            return {"builtin": list(BUILTIN_METHODS), "plugin": sorted(registry.methods)}
        case "weyriva.plugin.list":
            return plugin_summary(registry)
        case "weyriva.plugin.reload":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "plugin.reload takes no parameters")
            if reloader is None:
                raise ProtocolError("unavailable", "plugin reload requires the running daemon")
            return plugin_summary(reloader())
        case "weyriva.launcher.open":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "launcher.open takes no parameters")
            return _noctalia_ipc(["panel-toggle", "launcher"], os.environ)
        case "weyriva.notifications.dismiss_all":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "notifications.dismiss_all takes no parameters")
            return _noctalia_ipc(["notification-clear-active"], os.environ)
        case "weyriva.notifications.dnd":
            if params in ({}, None):
                return _noctalia_ipc(["notification-dnd-toggle"], os.environ)
            if isinstance(params, dict) and set(params) == {"enabled"} and isinstance(params["enabled"], bool):
                return _noctalia_ipc(
                    ["notification-dnd-set", "on" if params["enabled"] else "off"],
                    os.environ,
                )
            raise ProtocolError("invalid_params", 'notifications.dnd takes no parameters or {"enabled": bool}')
        case "weyriva.panel.toggle":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "panel.toggle takes no parameters")
            return _noctalia_ipc(["bar-toggle"], os.environ)
        case "weyriva.panel.reload":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "panel.reload takes no parameters")
            return _noctalia_ipc(["config-reload"], os.environ)
        case "weyriva.niri.outputs":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "niri.outputs takes no parameters")
            return _niri_json(["outputs"])
        case "weyriva.niri.windows":
            if params not in ({}, None):
                raise ProtocolError("invalid_params", "niri.windows takes no parameters")
            return _niri_json(["windows"])
        case _ if method in registry.methods:
            try:
                return run_plugin(registry.methods[method], params)
            except PluginError as error:
                raise ProtocolError("plugin_error", str(error)) from error
        case _:
            raise ProtocolError("method_not_found", f"unknown method: {method}")


def process_request(
    document: JsonValue,
    registry: PluginRegistry,
    reloader: Callable[[], PluginRegistry] | None = None,
) -> dict[str, JsonValue]:
    request_id: JsonValue = None
    try:
        if not isinstance(document, dict):
            raise ProtocolError("invalid_request", "request must be an object")
        request_id = document.get("id")
        if isinstance(request_id, (list, dict)):
            raise ProtocolError("invalid_request", "id must be a scalar JSON value")
        if document.get("protocol") != PROTOCOL_VERSION:
            raise ProtocolError("unsupported_protocol", f"protocol must be {PROTOCOL_VERSION}")
        method = document.get("method")
        if not isinstance(method, str) or not method:
            raise ProtocolError("invalid_request", "method must be a non-empty string")
        params: JsonValue = document.get("params", {})
        return {"id": request_id, "result": dispatch(method, params, registry, reloader)}
    except ProtocolError as error:
        return {"id": request_id, "error": {"code": error.code, "message": str(error)}}


def process_line(
    line: bytes,
    registry: PluginRegistry,
    reloader: Callable[[], PluginRegistry] | None = None,
) -> bytes:
    if len(line) > MAX_REQUEST_BYTES or not line.endswith(b"\n"):
        response: dict[str, JsonValue] = {
            "id": None,
            "error": {"code": "request_too_large", "message": "request must be one newline-terminated line up to 64 KiB"},
        }
    else:
        try:
            document: JsonValue = json.loads(line)
            response = process_request(document, registry, reloader)
        except (UnicodeError, json.JSONDecodeError):
            response = {"id": None, "error": {"code": "parse_error", "message": "invalid JSON"}}
    return json.dumps(response, ensure_ascii=False, separators=(",", ":")).encode() + b"\n"


class RequestHandler(socketserver.StreamRequestHandler):
    def handle(self) -> None:
        self.request.settimeout(READ_TIMEOUT)
        try:
            line = self.rfile.readline(MAX_REQUEST_BYTES + 1)
            if not line:
                return
            server: IpcServer = self.server  # type: ignore[assignment]
            self.wfile.write(process_line(line, server.registry, server.reload_plugins))
        except (socket.timeout, BrokenPipeError, ConnectionResetError):
            return


class IpcServer(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = False

    def __init__(self, path: str, registry: PluginRegistry) -> None:
        self.registry = registry
        self._handler_slots = threading.BoundedSemaphore(MAX_HANDLERS)
        super().__init__(path, RequestHandler)

    def reload_plugins(self) -> PluginRegistry:
        registry = discover_plugins()
        self.registry = registry
        return registry

    def verify_request(self, request: socket.socket, client_address: object) -> bool:
        if self._handler_slots.acquire(blocking=False):
            return True
        request.close()
        return False

    def process_request_thread(self, request: socket.socket, client_address: object) -> None:
        try:
            super().process_request_thread(request, client_address)
        finally:
            self._handler_slots.release()


def acquire_daemon_lock(path: Path) -> TextIO:
    lock = path.open("a+", encoding="utf-8")
    lock.flush()
    path.chmod(0o600)
    try:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        lock.close()
        raise RuntimeError("another Weyriva daemon is already running") from error
    return lock


def run_daemon() -> int:
    path = socket_path()
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    lock = acquire_daemon_lock(path.parent / "daemon.lock")
    try:
        if path.exists() or path.is_socket():
            mode = path.lstat().st_mode
            if not stat.S_ISSOCK(mode):
                raise RuntimeError(f"refusing to replace non-socket path: {path}")
            path.unlink()
        registry = discover_plugins()
        server = IpcServer(str(path), registry)
        path.chmod(0o600)

        def stop(_signum: int, _frame: object) -> None:
            raise KeyboardInterrupt

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        try:
            try:
                server.serve_forever(poll_interval=0.2)
            except KeyboardInterrupt:
                pass
        finally:
            server.server_close()
            if path.is_socket():
                path.unlink()
    finally:
        lock.close()
    return 0


def ipc_call(method: str, params: JsonValue, timeout: float = DEFAULT_TIMEOUT) -> dict[str, JsonValue]:
    request = {"protocol": PROTOCOL_VERSION, "id": 1, "method": method, "params": params}
    encoded = json.dumps(request, ensure_ascii=False, separators=(",", ":")).encode() + b"\n"
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(timeout)
        client.connect(str(socket_path()))
        client.sendall(encoded)
        chunks = bytearray()
        while not chunks.endswith(b"\n"):
            chunk = client.recv(4096)
            if not chunk:
                raise RuntimeError("daemon closed the connection without a response")
            chunks.extend(chunk)
            if len(chunks) > MAX_PLUGIN_OUTPUT_BYTES + MAX_REQUEST_BYTES:
                raise RuntimeError("daemon response is too large")
    parsed = json.loads(chunks)
    if not isinstance(parsed, dict):
        raise RuntimeError("daemon response is not an object")
    return parsed


def _json_argument(value: str) -> JsonValue:
    try:
        return json.loads(value)
    except json.JSONDecodeError as error:
        raise argparse.ArgumentTypeError(f"invalid JSON: {error.msg}") from error


def plugin_noctalia_arguments(arguments: argparse.Namespace) -> list[str]:
    command = arguments.plugin_command
    if command == "list":
        return ["msg", "plugins", "list"]
    if command in {"install", "enable"}:
        return ["msg", "plugins", "enable", arguments.plugin_id]
    if command == "disable":
        return ["msg", "plugins", "disable", arguments.plugin_id]
    if command == "update":
        return ["msg", "plugins", "update", arguments.source_name]
    if command == "lint":
        return ["plugins", "lint", *arguments.paths]
    if command == "source":
        forwarded = ["msg", "plugins", "source", arguments.source_command]
        if arguments.source_command == "add":
            forwarded.extend((arguments.name, arguments.kind, arguments.location))
        elif arguments.source_command == "remove":
            forwarded.append(arguments.name)
        return forwarded
    raise RuntimeError(f"unsupported native plugin command: {command}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="weyriva", description="Weyriva Shell control plane")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("daemon", help="run the user IPC daemon")
    commands.add_parser("status", help="check daemon status")
    diagnose = commands.add_parser("diagnose", help="diagnose the Niri desktop and login path")
    diagnose.add_argument("--json", action="store_true", help="print machine-readable JSON")
    startup = commands.add_parser("startup", help="manage the Niri login and startup chain")
    startup_commands = startup.add_subparsers(dest="startup_command", required=True)
    ensure = startup_commands.add_parser("ensure", help="back up and repair the complete startup chain")
    ensure.add_argument("--user", help="desktop user (defaults to SUDO_USER)")
    ipc = commands.add_parser("ipc", help="use the IPC protocol")
    ipc_commands = ipc.add_subparsers(dest="ipc_command", required=True)
    call = ipc_commands.add_parser("call", help="call an IPC method")
    call.add_argument("method")
    call.add_argument("--params", type=_json_argument, default={})
    shell = commands.add_parser("shell", help="run and control the Noctalia shell engine")
    shell_commands = shell.add_subparsers(dest="shell_command", required=True)
    shell_commands.add_parser("run", help="run the isolated Weyriva shell profile")
    shell_commands.add_parser(
        "reconcile-lock",
        help="reacquire the Noctalia lock after a shell restart when logind remains locked",
    )
    shell_msg = shell_commands.add_parser("msg", help="send a native Noctalia IPC command")
    shell_msg.add_argument("message_command")
    shell_msg.add_argument("message_arguments", nargs=argparse.REMAINDER)
    shell_config = shell_commands.add_parser("config", help="run a native Noctalia config command")
    shell_config.add_argument("config_command")
    shell_config.add_argument("config_arguments", nargs=argparse.REMAINDER)
    plugin = commands.add_parser("plugin", help="manage native Noctalia and legacy executable plugins")
    plugin_commands = plugin.add_subparsers(dest="plugin_command", required=True)
    plugin_commands.add_parser("list", help="list native Noctalia plugins")
    for command_name in ("install", "enable", "disable"):
        native_plugin = plugin_commands.add_parser(command_name)
        native_plugin.add_argument("plugin_id", help="canonical author/plugin identifier")
    plugin_update = plugin_commands.add_parser("update", help="update one native plugin source")
    plugin_update.add_argument("source_name")
    plugin_lint = plugin_commands.add_parser("lint", help="lint native Noctalia plugin sources")
    plugin_lint.add_argument("paths", nargs="*")
    plugin_source = plugin_commands.add_parser("source", help="manage native Noctalia plugin sources")
    plugin_source_commands = plugin_source.add_subparsers(dest="source_command", required=True)
    plugin_source_commands.add_parser("list")
    plugin_source_add = plugin_source_commands.add_parser("add")
    plugin_source_add.add_argument("name")
    plugin_source_add.add_argument("kind", choices=("git", "path"))
    plugin_source_add.add_argument("location")
    plugin_source_remove = plugin_source_commands.add_parser("remove")
    plugin_source_remove.add_argument("name")
    plugin_commands.add_parser("legacy-list", help="list legacy executable plugin methods")
    plugin_commands.add_parser("legacy-reload", help="reload legacy executable plugin manifests")
    plugin_validate = plugin_commands.add_parser("legacy-validate", help="validate a legacy plugin manifest")
    plugin_validate.add_argument("path", help="path to the manifest JSON file")
    session = commands.add_parser("session", help="manage the desktop session")
    session_commands = session.add_subparsers(dest="session_command", required=True)
    session_commands.add_parser("start", help="start niri as the current session")
    return parser


def _print_json(value: JsonValue) -> None:
    print(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True))


def session_environment(argv0: str, environment: Mapping[str, str]) -> dict[str, str]:
    executable = Path(argv0)
    if executable.parent == Path("."):
        located = shutil.which(argv0, path=environment.get("PATH"))
        if located is not None:
            executable = Path(located)
    executable_directory = str(executable.expanduser().resolve().parent)
    child_environment = dict(environment)
    path_entries = [entry for entry in child_environment.get("PATH", "").split(os.pathsep) if entry]
    if executable_directory not in path_entries:
        path_entries.insert(0, executable_directory)
    child_environment["PATH"] = os.pathsep.join(path_entries)
    return child_environment


def start_session(argv0: str, environment: Mapping[str, str]) -> NoReturn:
    niri_session = _diagnostic_command("niri-session")
    if niri_session is None:
        raise RuntimeError("niri-session is not installed; install niri before starting the session")
    config = niri_config_path(environment)
    if _diagnostic_command("niri") is None:
        raise RuntimeError("niri is not installed; install niri before starting the session")
    code, output = _run_diagnostic_command(["niri", "validate", "-c", str(config)])
    if code != 0:
        raise RuntimeError(f"Niri config is invalid ({config}): {output or 'validation failed'}")
    child_environment = session_environment(argv0, environment)
    child_environment["NIRI_CONFIG"] = str(config)
    os.execvpe("niri-session", ["niri-session"], child_environment)
    raise RuntimeError("niri-session exec unexpectedly returned")


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        if args.command == "daemon":
            return run_daemon()
        if args.command == "status":
            response = ipc_call("weyriva.ping", {})
            _print_json(response)
            return 0 if "result" in response else 1
        if args.command == "diagnose":
            checks = diagnose_checks()
            if args.json:
                _print_json(diagnostic_summary(checks))
            else:
                print_diagnostics(checks)
            return 0 if not any(check.status == "fail" for check in checks) else 1
        if args.command == "startup" and args.startup_command == "ensure":
            target_user = args.user or os.environ.get("SUDO_USER", "")
            return ensure_startup_chain(target_user)
        if args.command == "ipc" and args.ipc_command == "call":
            response = ipc_call(args.method, args.params)
            _print_json(response)
            return 0 if "result" in response else 1
        if args.command == "shell" and args.shell_command == "run":
            seed_noctalia_profile(os.environ)
            run_noctalia([], os.environ)
        if args.command == "shell" and args.shell_command == "reconcile-lock":
            return reconcile_lock(os.environ)
        if args.command == "shell" and args.shell_command == "msg":
            run_noctalia(["msg", args.message_command, *args.message_arguments], os.environ)
        if args.command == "shell" and args.shell_command == "config":
            run_noctalia(["config", args.config_command, *args.config_arguments], os.environ)
        if args.command == "plugin" and args.plugin_command == "legacy-list":
            _print_json(plugin_summary(discover_plugins()))
            return 0
        if args.command == "plugin" and args.plugin_command == "legacy-reload":
            response = ipc_call("weyriva.plugin.reload", {})
            _print_json(response)
            return 0 if "result" in response else 1
        if args.command == "plugin" and args.plugin_command == "legacy-validate":
            try:
                _print_json(validate_manifest(Path(args.path).expanduser()))
            except PluginError as error:
                print(f"weyriva: invalid manifest: {error}", file=sys.stderr)
                return 1
            return 0
        if args.command == "plugin":
            run_noctalia(plugin_noctalia_arguments(args), os.environ)
        if args.command == "session" and args.session_command == "start":
            start_session(sys.argv[0], os.environ)
        raise RuntimeError("unhandled command")
    except (ConnectionError, FileNotFoundError, OSError, ProtocolError, RuntimeError, socket.timeout, json.JSONDecodeError) as error:
        print(f"weyriva: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
